<?xml version="1.0" encoding="utf-8"?>
<!-- Same geometry as hush_logo.svg. Rings are cut short: the noise fading away around a calm centre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer ring (most broken up) -->
    <path
        android:pathData="M82,54 A28,28 0 1,1 26,54 A28,28 0 1,1 82,54"
        android:strokeColor="#5EEAD4"
        android:strokeAlpha="0.35"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:trimPathStart="0"
        android:trimPathEnd="0.45"
        android:trimPathOffset="0.30" />

    <!-- middle ring -->
    <path
        android:pathData="M74,54 A20,20 0 1,1 34,54 A20,20 0 1,1 74,54"
        android:strokeColor="#5EEAD4"
        android:strokeAlpha="0.65"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:trimPathStart="0"
        android:trimPathEnd="0.66"
        android:trimPathOffset="0.15" />

    <!-- inner ring -->
    <path
        android:pathData="M66,54 A12,12 0 1,1 42,54 A12,12 0 1,1 66,54"
        android:strokeColor="#5EEAD4"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:trimPathStart="0"
        android:trimPathEnd="0.80" />

    <!-- calm centre -->
    <path
        android:fillColor="#A5B4FC"
        android:pathData="M54,48 A6,6 0 1,1 54,60 A6,6 0 1,1 54,48 Z" />
</vector>
